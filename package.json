{
  "name": "pulse-supabase",
  "version": "0.0.0",
  "private": true,
  "description": "PULSE shared backend: database, auth and Edge Functions",
  "license": "UNLICENSED",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve",
    "functions:test": "deno test --allow-env --allow-net --allow-read --permit-no-files supabase/functions",
    "types": "supabase gen types typescript --local > types/database.ts",
    "check": "npm run db:reset && npm run db:test && npm run functions:test"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^3.0.0"
  }
}
